# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://invitee.co.tz
NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://invitee_user:YOUR_DB_PASSWORD@localhost:5432/invitee?schema=public"

# ── Redis (Memurai) ──────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=GENERATE_A_STRONG_SECRET_HERE

# ── Email (Nodemailer / SMTP) ─────────────────────────────────────────────────
SMTP_HOST=mail.invitee.co.tz
SMTP_PORT=587
SMTP_USER=info@invitee.co.tz
SMTP_PASS=YOUR_SMTP_PASSWORD
EMAIL_FROM_NAME=Invitee
EMAIL_FROM_ADDRESS=noreply@invitee.co.tz

# ── SMS — Kenosis Technologies (Beem Africa gateway) ─────────────────────────
KENOSIS_API_URL=https://apisms.beem.africa/v1/send
KENOSIS_API_KEY=YOUR_KENOSIS_API_KEY
KENOSIS_SECRET_KEY=YOUR_KENOSIS_SECRET_KEY
KENOSIS_SENDER_ID=INVITEEY

# ── WhatsApp — WaSender ──────────────────────────────────────────────────────
WASENDER_API_URL=https://www.wasenderapi.com/api
WASENDER_API_KEY=YOUR_WASENDER_API_KEY
WASENDER_WEBHOOK_SECRET=YOUR_WASENDER_WEBHOOK_SECRET

# ── WhatsApp — AuthKey.io (optional second vendor, admin-selectable at send time) ──
# AUTHKEY_WHATSAPP_TEMPLATE_ID must point to a WhatsApp template approved on
# console.authkey.io with exactly ONE body variable ({{1}}) — the full
# pre-formatted invitation text is sent through as that variable. If the
# template also has an IMAGE header, the e-card image URL is attached there.
AUTHKEY_API_URL=https://console.authkey.io/restapi/requestjson.php
AUTHKEY_API_KEY=YOUR_AUTHKEY_API_KEY
AUTHKEY_WHATSAPP_TEMPLATE_ID=YOUR_AUTHKEY_WHATSAPP_TEMPLATE_ID

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ── File Storage ──────────────────────────────────────────────────────────────
# Local dev: relative path. Production: /var/www/invitee/uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ── Misc ──────────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
